# ─── Better Auth ─────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here
# Base URL of your Next.js app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# ─── Google OAuth ────────────────────────────────────────────
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Database (Supabase / Postgres) ──────────────────────────
# Connection string from Supabase → Settings → Database
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ─── Cloudflare ──────────────────────────────────────────────
# Account ID from Cloudflare dashboard → right sidebar
CLOUDFLARE_ACCOUNT_ID=
# API Token with KV edit permissions: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
# KV Namespace ID: wrangler kv:namespace create SLUGS → copy the id
CLOUDFLARE_KV_NAMESPACE_ID=

# ─── Cloudflare Worker URL ───────────────────────────────────
# URL of your deployed redirect worker (no trailing slash)
# Shown after: wrangler deploy
NEXT_PUBLIC_SHORT_URL_BASE=https://corto.your-subdomain.workers.dev

# ─── Web Push (optional — for push notifications) ────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # same as VAPID_PUBLIC_KEY

# ─── External API secret (optional) ─────────────────────────
# Protects the /api/clicks endpoint if used externally
EXTERNAL_API_SECRET=
